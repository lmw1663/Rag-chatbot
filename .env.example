# .env.local로 복사해 값을 채운다. 모두 서버 전용이라 NEXT_PUBLIC_ 접두사를 붙이지 않는다.

# Supabase 프로젝트 URL과 secret 키(service_role 권한, RLS 우회)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Claude API (/api/chat 답변 생성)
ANTHROPIC_API_KEY=

# Voyage 임베딩 (인제스트, 질문 임베딩)
VOYAGE_API_KEY=

# 관리자 페이지(/admin) Basic 인증. 둘 중 하나라도 비어 있으면 관리자 페이지는 항상 막힌다
ADMIN_USERNAME=
ADMIN_PASSWORD=
